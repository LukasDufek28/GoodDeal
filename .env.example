# Example environment variables for GoodDeal
# Copy this file to `.env` in the project root and fill in actual values.

# Regional search (Bazos fields)
# Postal code or place (e.g., "903 01" or "Bratislava"). '+' is normalized to a space.
HLOKALITA=
# Radius in km (e.g., 40)
HUMKREIS=

# Telegram notifications (optional)
# Create a bot via @BotFather and paste the token here
TELEGRAM_BOT_TOKEN=
# Your chat ID (send a message to your bot and query getUpdates, or use a helper bot)
TELEGRAM_CHAT_ID=
